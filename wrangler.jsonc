{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dbvmsc-campori-app",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "campori",
      "database_id": "b9e02479-7b6f-494a-9ac7-67b9127a5696"
    }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
